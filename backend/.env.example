PREPAREME_APP_NAME=PrepareMe API
PREPAREME_ENVIRONMENT=local
PREPAREME_DEBUG=false
PREPAREME_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/prepareme
PREPAREME_REDIS_URL=redis://localhost:6379/0
PREPAREME_CELERY_BROKER_URL=redis://localhost:6379/0
PREPAREME_CELERY_RESULT_BACKEND=redis://localhost:6379/1
PREPAREME_AUTH_MODE=local_jwt
PREPAREME_JWT_SECRET=prepareme-local-dev-secret
PREPAREME_JWT_ISSUER=prepareme.local
PREPAREME_JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
PREPAREME_BOOTSTRAP_DEMO_DATA=true
PREPAREME_TURNSTILE_ENABLED=true
PREPAREME_TURNSTILE_SITE_KEY=1x00000000000000000000AA
PREPAREME_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
PREPAREME_TURNSTILE_EXPECTED_HOSTNAME=
PREPAREME_CLERK_JWKS_URL=
PREPAREME_CLERK_ISSUER=
PREPAREME_AUTH_AUDIENCE=
PREPAREME_SENTRY_DSN=
